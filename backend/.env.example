# Labby backend — environment variables.
# Copy to .env (`cp .env.example .env`) and set JWT_SECRET; never commit .env. `make run`
# loads .env when present. Every variable EXCEPT JWT_SECRET has a working local default
# baked into application.yml / docker-compose.yml; JWT_SECRET has none on purpose (the app
# refuses to boot without it).

# --- Database (docker-compose and the app read these) ---
# Database name created by the Postgres container.
DB_NAME=labby
# Host port the Postgres container listens on.
DB_PORT=5432
# JDBC URL the application connects with.
DB_URL=jdbc:postgresql://localhost:5432/labby
# Database credentials (compose creates them, the app connects with them).
DB_USERNAME=labby
DB_PASSWORD=labby

# --- Flyway ---
# Toggle migrations (leave true; Flyway owns the schema).
FLYWAY_ENABLED=true
# Migration locations on the classpath.
FLYWAY_LOCATIONS=classpath:db/migration

# --- HTTP server ---
SERVER_PORT=8080
SPRING_APPLICATION_NAME=labby-backend
# Active Spring profile: dev (readable logs) or prod (JSON logs).
SPRING_PROFILES_ACTIVE=dev

# --- Actuator ---
# Comma-separated actuator endpoints to expose over HTTP.
ACTUATOR_ENDPOINTS=health,info
# Kubernetes-style liveness/readiness probe groups on /actuator/health.
ACTUATOR_HEALTH_PROBES_ENABLED=true

# --- API docs (disable both in prod if the API must stay private) ---
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html

# --- Logging ---
# Root log level.
LOG_LEVEL=INFO
# Log level for com.labby.backend loggers.
LOG_LEVEL_APP=INFO

# --- CORS ---
# Comma-separated browser origins allowed to call /api/** (admin dashboard).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth (M2) ---
# HS256 signing secret for JWTs. Generate a long random value; NEVER commit a real one.
# REQUIRED: the app has no fallback and refuses to boot without it.
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (seconds).
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime (seconds). Rotated on every refresh.
JWT_REFRESH_TTL_SECONDS=1209600

# Failed-login throttling per phone+IP (NFR-S3): max failures inside the window -> 429.
LOGIN_THROTTLE_MAX_ATTEMPTS=10
LOGIN_THROTTLE_WINDOW_SECONDS=900
# Daily purge of expired failed-login counters (Spring cron; "-" disables)
LOGIN_FAILURE_PURGE_CRON="0 40 3 * * *"

# --- OTP policy (AUTH-04; defaults match the SRS) ---
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5

# --- SMS gateway (ES-01; owner-operated Traccar SMS Gateway app) ---
# Cloud service (default): Traccar's relay forwards to the owner's phone.
# Local service alternative: the phone's own HTTP API, e.g. http://<phone-ip>:8082
# (enable "Local Service" in the app and use its local token instead).
SMS_GATEWAY_URL=https://www.traccar.org/sms/
# Token from the app's Gateway screen (cloud token for the cloud URL, local token
# for a local URL). Sent raw in the Authorization header. NEVER commit a real one.
SMS_GATEWAY_TOKEN=change-me

# --- Private upload storage (NFR-S2) ---
# Local directory for private user uploads (photos now, driver documents in M5).
STORAGE_DIR=./data/uploads
# Maximum accepted profile-photo upload size in bytes (default 5 MiB).
STORAGE_PHOTO_MAX_BYTES=5242880
# Maximum accepted driver document (JPEG/PNG/PDF) or vehicle photo (JPEG/PNG) size (default 10 MiB).
STORAGE_DRIVER_FILE_MAX_BYTES=10485760
# Lifetime in seconds of the expiring URLs that serve private files (documents, vehicle photos).
STORAGE_URL_TTL_SECONDS=300
# Uploads one user may make to /driver/files per rolling 24 hours (429 beyond it).
STORAGE_DRIVER_FILE_DAILY_CAP=50
# Nightly cleanup: uploads no document or vehicle photo references are deleted after this many
# days, on this Spring cron (operating timezone; "-" disables it).
STORAGE_ORPHAN_FILE_RETENTION_DAYS=7
STORAGE_ORPHAN_CLEANUP_CRON="0 30 3 * * *"

# --- Driver onboarding (M5) ---
# Operating timezone whose calendar date is "today" for document expiry (a document is valid
# THROUGH its expiry date). Launch market: Syria.
ONBOARDING_TIMEZONE=Asia/Damascus
# Cron of the daily document-expiry job (30/7-day reminders + auto-suspension), evaluated in
# ONBOARDING_TIMEZONE. Spring format: second minute hour day month weekday; "-" disables it.
ONBOARDING_EXPIRY_JOB_CRON="0 5 0 * * *"

# --- Scheduling ---
# Threads shared by all scheduled jobs (ride dispatch/monitor, notification outbox, surge, …).
# Keep it above 1 so a slow push pass never stalls the ride jobs (M10 review B-W4).
SCHEDULER_POOL_SIZE=4

# --- Notifications (M6) ---
# Cron of the outbox dispatcher that fills the notification center and sends pushes (default every
# 5 seconds). Spring format: second minute hour day month weekday; "-" disables it.
NOTIFICATIONS_DISPATCH_CRON="*/5 * * * * *"
# Firebase service-account credentials for FCM push (ES-03). Set ONE: a path to the JSON file, or
# the JSON itself. NEVER commit them. Both empty = pushes are logged, not sent (the notification
# center still records every notification).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# --- Tracking & realtime (M6) ---
# Driver GPS sample cadence in seconds while online (TRK-01).
LOCATION_INTERVAL_SECONDS=5
# Seconds without a sample after which an online driver is stale and gets no offers (TRK-04).
LOCATION_STALE_SECONDS=30
# WebSocket /api/v1/realtime: seconds a new socket has to send its auth frame, seconds without
# any frame before the server closes it, and how often expiry/revocation/idleness are checked.
REALTIME_AUTH_TIMEOUT_SECONDS=10
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_CHECK_INTERVAL_SECONDS=5

# --- Routing (M6, ES-04) ---
# OSRM base URL (public demo server in V1; point at a self-hosted OSRM before launch).
ROUTING_OSRM_URL=https://router.project-osrm.org
# Seconds to wait for OSRM before falling back to the straight-line estimate.
ROUTING_OSRM_TIMEOUT_SECONDS=3
# Straight-line fallback (NFR-A3): great-circle distance x detour factor, at this speed (km/h).
ROUTING_FALLBACK_DETOUR_FACTOR=1.3
ROUTING_FALLBACK_SPEED_KMH=25

# --- Rides (M7, rides-v1.yaml) ---
# Seconds a driver has to answer an offer; minutes after the request before dispatch gives up
# (RIDE-03); the "Arrived" geofence in meters (RIDE-04).
DISPATCH_OFFER_SECONDS=15
DISPATCH_GIVE_UP_MINUTES=10
ARRIVE_GEOFENCE_METERS=100
# Nearest eligible drivers (straight line) ranked by routed pickup ETA for each offer.
DISPATCH_CANDIDATE_POOL_SIZE=5
# The rider-facing ETA is recomputed at most this often per ride, in seconds (TRK-02).
RIDE_ETA_REFRESH_SECONDS=30
# Dispatcher and ride-monitor ticks (Spring cron; "-" disables).
DISPATCH_CRON="* * * * * *"
RIDE_MONITOR_CRON="*/5 * * * * *"

# --- Money (M8, money-v1.yaml) ---
# A driver balance within this much above the region's floor is status "warning" (COM-03).
# Fallback only: a region's own floorWarningMargin (admin region bundle, V36) overrides it.
MONEY_FLOOR_WARNING_MARGIN=10
# Weekly commission recalc (COM-02): computes each driver's rate per region from the previous
# Monday-start week's completed trips (weeks evaluated in each region's time zone). Spring cron
# (second minute hour day month weekday, ONBOARDING_TIMEZONE); "-" disables it. A completion
# computes a missing week rate itself, so the job only pre-warms the rows.
MONEY_COMMISSION_RECALC_CRON="0 10 0 * * MON"

# --- Surge (M9, regions-v1.yaml / surge-v1.yaml) ---
# Surge cycle (PRC-02): recomputes every zone's multiplier from open requests vs idle online
# drivers; a manual override or its reset takes effect at the next cycle (UC-A-09). Spring cron
# (second minute hour day month weekday); "-" disables it.
SURGE_CYCLE_CRON="0 */2 * * * *"

# --- Hosting / ops ---
# Self keepalive for a free-tier host that idles out (Render demo): the instance's own public
# health URL, requested every KEEPALIVE_INTERVAL_SECONDS. Leave blank to disable (local, CI).
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_SECONDS=600

# --- Comms & safety (M10, comms-v1.yaml) ---
# Public origin trip-share urls are built on (SHARE-01): <PUBLIC_BASE_URL>/share/<token>.
# Set it to the address riders' contacts can reach (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8080
# How often the public share page polls its data endpoint, in seconds (SHARE-02).
SHARE_REFRESH_SECONDS=5
# How often the admin live ops map polls its snapshot, in seconds (ADM-03).
LIVEOPS_REFRESH_SECONDS=5

# --- Trust & quality (M11, trust-v1.yaml) ---
# REP-03: this many substantiated reports against one user x role whose resolution falls within
# the last REPORT_FLAG_DAYS days open a report_threshold flag (flag only, never a suspension).
REPORT_FLAG_COUNT=3
REPORT_FLAG_DAYS=90
# RATE-02: daily rewrite of the rating snapshots riders and drivers see. DRV-07: periodic driver
# metric-warning evaluation (raise / clear). Spring cron (second minute hour day month weekday,
# ONBOARDING_TIMEZONE); "-" disables.
# Keep it DAILY: the RATE-02 privacy model (batched snapshots, nightly USR-05) assumes it.
TRUST_RATING_SNAPSHOT_CRON="0 20 0 * * *"
TRUST_METRIC_WARNING_CRON="0 0 * * * *"

# --- Support & content (M14, support-v1.yaml) ---
# Hours a ticket waits in waiting_on_user without a user reply before its ONE reminder push
# (owner ruling 2026-10-19), and the reminder job's Spring cron (second minute hour day month
# weekday, ONBOARDING_TIMEZONE); "-" disables it.
SUPPORT_WAITING_REMINDER_HOURS=48
SUPPORT_REMINDER_CRON="0 */15 * * * *"

# --- Scheduled & shared rides (M12, scheduled-shared-v1.yaml) ---
# Spring cron of the scheduled-ride clock job (reminders, conversion / fallback at T - lead, shared
# departure and expiry; default every 30 s), the rides it handles per run, and how long a "when
# full" shared ride may stay unfilled before it is cancelled. "-" disables the job. Per-region
# timing lives on the region (scheduledSettings), not here.
SCHEDULED_RIDES_CRON="*/30 * * * * *"
SCHEDULED_RIDES_BATCH_SIZE=200
SHARED_WHEN_FULL_EXPIRY_HOURS=24

# --- Analytics & CSV export (M15, analytics-v1.yaml) ---
# PostgreSQL statement_timeout of every analytics / export SQL statement (503 query_timeout when
# hit), and the most rows one CSV export may hold (422 export_too_large above it).
ANALYTICS_STATEMENT_TIMEOUT=10s
ANALYTICS_EXPORT_MAX_ROWS=50000

# --- Incentives engine (M15, incentives-v1.yaml) ---
# Spring cron of the incentive evaluation (operating timezone; default hourly). Every run pays each
# region's last finished Monday–Sunday week in that region's time zone, each award once, so a
# missed run is caught up by the next; "-" disables.
INCENTIVES_CRON="0 0 * * * *"

# --- Dev ride simulator (M7-T5, dev profile only) ---
# The seeded demo drivers below accept offers and drive rides along real routes, so the ride
# loop runs on the emulator with no physical driver device. Off by default.
RIDE_SIM_ENABLED=false
RIDE_SIM_TICK_MS=1000
RIDE_SIM_SPEED_KMH=40
# Ticks before accepting an open offer, and before arrive->start / complete->cash-confirm.
RIDE_SIM_ACCEPT_DELAY_TICKS=2
RIDE_SIM_DWELL_TICKS=3
RIDE_SIM_DRIVERS=+963900000006,+963900000007
# Where idle sim drivers wait (inside the demo Damascus region).
RIDE_SIM_CENTER_LAT=33.515
RIDE_SIM_CENTER_LNG=36.28
