# Keep React Native's own fetch. Expo 57 replaces global fetch with expo/fetch
# (expo/src/winter/runtime.native.ts), which rejects RN {uri,name,type} FormData
# parts, so every photo/file upload failed before leaving the device (L-C1).
# Not a secret: this file is tracked on purpose (see .gitignore).
EXPO_PUBLIC_USE_RN_FETCH=1
